# Application
APP_NAME=AI Agent Platform
ENVIRONMENT=development
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend
FRONTEND_PORT=3000
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_agent_platform

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_TIMEOUT=60

# Agent runtime
AGENT_MAX_ITERATIONS=8

# Authentication (change JWT_SECRET_KEY before production deployment)
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Lead notifications (logging writes emails to application logs)
NOTIFICATION_PROVIDER=logging
NOTIFICATION_FROM_EMAIL=
RESEND_API_KEY=
FRONTEND_BASE_URL=http://localhost:3000
