# Application
APP_NAME=AI Anfragen-Assistent
ENVIRONMENT=development
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend
FRONTEND_PORT=3000
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
# Calendly or booking link for pilot sales CTA (falls back to mailto if empty)
NEXT_PUBLIC_PILOT_BOOKING_URL=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_agent_platform

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_TIMEOUT=60

# Agent runtime
AGENT_MAX_ITERATIONS=8

# Authentication (change JWT_SECRET_KEY before production deployment)
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email delivery (lead notifications + password reset)
#
# Development (default): emails go to backend logs; forgot-password shows a link in the UI.
# NOTIFICATION_PROVIDER=logging
#
# Production / real emails via Resend (https://resend.com):
# 1. Verify your domain in Resend
# 2. Create API key → RESEND_API_KEY
# 3. Set NOTIFICATION_FROM_EMAIL to a verified sender (e.g. "AI Anfragen-Assistent <noreply@yourdomain.com>")
# 4. Set FRONTEND_BASE_URL to your public dashboard URL (used in email links)
# 5. docker compose restart backend
NOTIFICATION_PROVIDER=logging
NOTIFICATION_FROM_EMAIL=
RESEND_API_KEY=
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000
WIDGET_STALE_AFTER_HOURS=168

# Local business site preview at http://localhost:3000/site
PILOT_COMPANY_SLUG=mikes-sanitarbetrieb

# Self-serve onboarding via /onboarding (enabled by default in development)
SELF_SERVE_REGISTRATION_ENABLED=true

# Voice pilot (Vapi webhook). Leave empty in local dev to skip header checks.
# VAPI_WEBHOOK_SECRET=
