# Production environment template — copy to .env and fill in real values.
# Never commit the resulting .env file.

APP_ENV=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Public domains (used by Caddy for HTTPS and routing)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Root marketing site with widget embed (comma-separated for apex + www)
SITE_DOMAIN=example.com, www.example.com
PILOT_COMPANY_SLUG=your-company-slug
SITE_COMPANY_SLUG=your-company-slug
ACME_EMAIL=admin@example.com

CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
FRONTEND_BASE_URL=https://app.example.com
PUBLIC_API_BASE_URL=https://api.example.com
WIDGET_STALE_AFTER_HOURS=168

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ai_agent_platform

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

NOTIFICATION_PROVIDER=resend
NOTIFICATION_FROM_EMAIL=notifications@example.com
RESEND_API_KEY=

# Inbound customer requests via Resend Receiving.
# Each tenant receives <company-slug>@<RESEND_INBOUND_DOMAIN>.
INTAKE_EMAIL_ENABLED=false
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=inbox.example.com
RESEND_RECEIVE_TIMEOUT=30
INTAKE_WORKER_POLL_SECONDS=5
INTAKE_WORKER_LEASE_SECONDS=300
INTAKE_MAX_PROCESSING_ATTEMPTS=3

# Set to true to allow /onboarding self-serve sign-up in production (rate-limited).
SELF_SERVE_REGISTRATION_ENABLED=false
