# Production environment template — copy to .env and fill in real values.
# Never commit the resulting .env file.

APP_ENV=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Public domains (used by Caddy for HTTPS and routing)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
FRONTEND_BASE_URL=https://app.example.com

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ai_agent_platform

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

NOTIFICATION_PROVIDER=resend
NOTIFICATION_FROM_EMAIL=notifications@example.com
RESEND_API_KEY=
